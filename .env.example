# Reference only: export variables; .env is not automatically loaded.
# CLI defaults to ~/ig_intel/Inbox; old IG_INTEL_VAULT still works.
# SONAWEFT_VAULT=~/my-vault
# SONAWEFT_PYTHON=/path/to/python
# INSTASCRIPT_CPU_THREADS=4
# YTDLP_COOKIES_FROM_BROWSER=firefox
# DEEPSEEK_API_KEY=your-private-key

# Hosted secret: sonaweft-session (generate with Fernet.generate_key)
# SONAWEFT_SESSION_KEY=your-private-fernet-key
# Hosted secret: sonaweft-llm
# DEEPSEEK_API_KEY=your-private-key

# Hosted secret: sonaweft-payments — closed until actual approval/tests.
BILLING_MODE=test
BILLING_PROVIDER=paddle
PADDLE_ENVIRONMENT=production
PADDLE_SELLER_APPROVED=false
SONAWEFT_HOSTED_READY=false
# PADDLE_API_KEY=your-private-runtime-key
# PADDLE_CLIENT_TOKEN=your-public-client-token
# PADDLE_PRODUCT_ID=your-own-product
# PADDLE_PRICE_5=your-own-price
# PADDLE_PRICE_10=your-own-price
# PADDLE_WEBHOOK_SECRET=your-private-signing-key
# PADDLE_CHECKOUT_URL=https://your-deployment/checkout
