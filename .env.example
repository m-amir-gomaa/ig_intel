# instaScript — environment variables (copy to .env or export in your shell)

# Where transcripts + knowledge live. Defaults to ~/ig_intel.
# Point this at your Obsidian vault to enable the optional second-brain workflow.
# IG_INTEL_VAULT=~/ig_intel

# DeepSeek API key — REQUIRED only for --review / --review-item
# (DeepSeek summary + factual flagging of transcripts).
# DEEPSEEK_API_KEY=sk-...

# Reserved for the future web-search/RAG phase.
# OPENROUTER_API_KEY=sk-or-...

# Browser to source login cookies from when a platform (Instagram, ...) requires
# a logged-in session. Comma-separated = retry order; empty disables.
# YTDLP_COOKIES_FROM_BROWSER=firefox
